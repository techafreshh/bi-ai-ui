# Copy to agent/.env and fill in your key: cp .env.example agent/.env
# Server-side only — the SPA never sees these values.
# Without a key the demo runs in deterministic local mode (seeded data,
# policy decisions, canned narrative); with a key the decisions endpoint and
# the streamed narrative go live.
OPENROUTER_API_KEY=

# Text model used for the narrative (OpenRouter model id, chat completions).
TEXT_MODEL=openai/gpt-6-luna

# Decision layer (see the README model swap guide):
#   DECISION_TRANSPORT=auto → chain when a key is set, local policy otherwise
#                 live      → always chain (decisions endpoint → chat
#                             structured outputs → local policy)
#                 mock      → always the deterministic local policy (CI/tests)
DECISION_TRANSPORT=auto
DECISION_MODEL=~perplexity/pplx-decider-flash-latest
DECISION_CHAT_MODEL=anthropic/claude-haiku-5.5
DECISION_THRESHOLD=0.6
