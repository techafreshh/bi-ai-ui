# Copy to agent/.env (gitignored):
#   cp agent/.env.example agent/.env
# Every value below equals the code default — copying the file is
# behavior-neutral; edit only what you want to change. Variables apply when
# the agent (re)starts: `docker compose up -d agent` recreates the container
# with the edited .env (no image rebuild, no code edits). Lines are plain
# KEY=value with no inline comments, so compose's env_file parser and the
# agent's float()/int() reads take the value verbatim.

# --- OpenRouter (create a key at https://openrouter.ai/keys) -----------------
# Without a key the agent still boots and serves /health: the decider falls
# back to its deterministic heuristic transport and fill writes KPI-grounded
# copy instead of model text. The key never reaches the browser.
OPENROUTER_API_KEY=
TEXT_MODEL=openai/gpt-6-luna
# OpenAI-compatible endpoint for the text model and both decision transports;
# set it only to point them at a different (e.g. fake, for tests) server.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Decision models (issues #9 and #19) -------------------------------------
# DECISION_MODEL is the decisions-modality model the primary transport POSTs
# the question batch to; it is reported verbatim in the drawer's
# decisions[].model field. Example: DECISION_MODEL=inception/mercury-decide:free
# DECISION_FALLBACK_MODELS is the comma-separated chat-completions fallback
# chain (response_format: json_schema) engaged when the decisions endpoint
# fails; anthropic/claude-haiku-5.5 is a documented alternative member.
DECISION_MODEL=~perplexity/pplx-decider-flash-latest
DECISION_FALLBACK_MODELS=inception/mercury-decide:free,openai/gpt-6-luna
# Per-type overrides (issue #19): replace the primary decision model for
# that one question type only; the chat fallback chain is shared and stays
# DECISION_FALLBACK_MODELS. Empty = use DECISION_MODEL.
DECISION_MODEL_CHOICE=
DECISION_MODEL_NOUL=
DECISION_MODEL_SCORE=
# Endorsement line (inclusive >=) for above_threshold flagging; components
# whose choice probability falls below it are cut from the layout. Example:
# DECISION_THRESHOLD=0.95 empties the canvas into the insight_text fallback.
# A non-numeric value fails the decision client's wiring loud.
DECISION_THRESHOLD=0.6
# Per-request timeout in seconds for both decision transports (keeps a stuck
# endpoint inside the live 10s answer budget).
DECISION_TIMEOUT_S=8.0

# --- Bind address (server.py's --host/--port defaults) ------------------------
# AGENT_HOST/AGENT_PORT win over HOST/PORT; all four default to the pinned
# values below (0.0.0.0:8123). docker-compose.yml maps 8123 regardless.
AGENT_HOST=0.0.0.0
HOST=0.0.0.0
AGENT_PORT=8123
PORT=8123
