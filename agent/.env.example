# Copy to agent/.env:
#   cp agent/.env.example agent/.env
# The key stays server-side (agent/.env is gitignored).
OPENROUTER_API_KEY=

# Optional overrides
TEXT_MODEL=openai/gpt-6-luna
# OPENROUTER_BASE_URL defaults to https://openrouter.ai/api/v1 — set it only
# to point the chat model at a different OpenAI-compatible endpoint.
# DECISION_THRESHOLD=0.6 — optional; the min probability for above_threshold
# flagging on decision answers (answers whose top probability falls below
# it are flagged for the default view; default 0.6).

# Decision transports (issue #9) — all optional, defaults shown:
# DECISION_MODEL=~perplexity/pplx-decider-flash-latest — the OpenRouter
#   decisions-modality model the primary transport POSTs the PRD §10 batch
#   wire format to.
# DECISION_FALLBACK_MODELS=inception/mercury-decide:free,openai/gpt-6-luna —
#   comma-separated chat-completions fallback chain (response_format:
#   json_schema); anthropic/claude-haiku-5.5 is a documented alternative
#   chain member.
# DECISION_TIMEOUT_S=8.0 — per-request timeout for both decision transports
#   (keeps a stuck endpoint inside the live 10s answer budget).
